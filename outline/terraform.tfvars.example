# Copy to terraform.tfvars (ignored by git) and fill in your values.
# Any variable can also be passed on the command line:
#   terraform apply -var='regions=["us-west1","europe-west1"]'

project_id = "your-gcp-project-id"

# Optional: defaults to the project's default Compute Engine service account.
# service_account_email = "PROJECT_NUMBER-compute@developer.gserviceaccount.com"

regions = ["us-west1", "europe-west1", "asia-southeast1"]

# Instances are named <prefix>-<region>, e.g. outline-us-west1.
# Lowercase letters, digits and hyphens only.
instance_name_prefix = "outline"

# Name of the firewall rule that opens the Outline ports.
# Lowercase letters, digits and hyphens only.
firewall_name = "allow-outline"

# SSH settings used to run postscript.sh (Docker + Outline install).
# ssh_user             = "outline"
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"
# Narrow SSH to your own IP:
# ssh_source_ranges    = ["203.0.113.4/32"]
# Close port 22 (disable the SSH firewall rule) after the install. Needs gcloud.
# close_ssh_after_install = true

# Stop each VM after this many hours of running (0 = no limit). Restarts on next apply.
# Keep the value you want here; a plain `terraform apply` resets it to this.
# e.g. 12 = 12 hours, 720 = 30 days
run_hours = 0
# How a run_hours change applies to a running VM: "reset" (from now) or "append" (add to time left).
# run_hours_mode = "reset"

# Outline access keys (VPN keys), printed as ss:// links in the apply output.
# data_limit_gb: limit per key (decimal GB, like Outline Manager); omit for no limit.
# Both modes reset data usage to 0 and keep each key's ss:// link (same password):
# reset mode does it now, append mode at the old shutdown time. In reset mode,
# keys not listed here (including ones made in Manager) are deleted.
# Leave empty to manage keys yourself in Outline Manager.
# access_keys = {
#   alice = { data_limit_gb = 200 }
#   bob   = {}
# }
